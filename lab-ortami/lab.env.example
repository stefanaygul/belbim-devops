# Lab ortam dosyasi. Rehberlerdeki butun adresler ve adlar buradan gelir; sir icermez.
# sandbox modunda `make env` bu dosyadan `lab.env` uretir (alan adi .env'den gelir).
# integration modunda (BELBIM ortami) `lab.env` adiyla kopyalanir ve elle doldurulur.

# sandbox | integration
LAB_MODE=sandbox

GITLAB_URL=https://gitlab.kurum.test
GITLAB_HOST=gitlab.kurum.test
REGISTRY=gitlab.kurum.test:5050
JENKINS_URL=https://jenkins.kurum.test
SONAR_URL=https://sonar.kurum.test
NEXUS_URL=https://nexus.kurum.test
TEST_VM=test-vm.kurum.test
TEST_VM_USER=deploy

# GitLab yollari
GITLAB_GROUP=egitim
TEMPLATE_PROJECT=egitim/sablonlar/portal-starter

# Ic ayna: Dockerfile'lardaki ARG MCR ve ARG HUB icin --build-arg degeri
MCR=gitlab.kurum.test:5050/egitim/base
HUB=gitlab.kurum.test:5050/egitim/base

# Nexus depolari
NUGET_GROUP_URL=https://nexus.kurum.test/repository/nuget-group/index.json
NUGET_HOSTED_URL=https://nexus.kurum.test/repository/nuget-hosted/
NPM_GROUP_URL=https://nexus.kurum.test/repository/npm-group/
NPM_HOSTED_URL=https://nexus.kurum.test/repository/npm-hosted/

# Kurum CA sertifikasinin egitim makinesindeki yeri
CA_CERT=/etc/lab/kurum-ca.crt

# Hangi lab akisi uygulanacak
# GITLAB_TIER: bilgi amaclidir. Lablar ucretli katman ozelliklerini (approval rules, Code Owners)
# kullanmaz; LAB 02-A her katmanda ayni akisla calisir.
# SONAR_PROFILE: community (analiz yalnizca develop'ta) | commercial
GITLAB_TIER=free
SONAR_PROFILE=community
