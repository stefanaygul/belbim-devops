# ${LAB_DOMAIN} container baslarken yerine yazilir; nginx degiskenleri ($host vb.) oldugu gibi kalir.

server {
    listen 80 default_server;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name gitlab.${LAB_DOMAIN};

    location / {
        set $upstream http://gitlab:80;
        proxy_pass $upstream;
        include /etc/nginx/snippets/proxy.conf;
    }
}

# Container Registry: gitlab.<D>:5050
