# Lab ortami yonetici ayarlari. `make env` bu dosyadan `.env` uretir ve bos
# birakilan sirlari doldurur. `.env` repoya girmez.

COMPOSE_PROJECT_NAME=belbim-lab

# Alan adi: servisler gitlab.<D>, jenkins.<D>, sonar.<D>, nexus.<D>, test-vm.<D>
LAB_DOMAIN=kurum.test

# Lab aginin ilk uc okteti. .10 proxy, .20 test-vm, .53 DNS.
LAB_SUBNET=172.30.99

# Ekip sayisi (1-10). Prova ekibi ekip-99 bundan bagimsizdir.
EKIP_SAYISI=2

# community | commercial
SONAR_PROFILE=community

# Host'ta yayinlanan portlar (yalnizca 127.0.0.1). Container icindeki portlar degismez.
# HTTPS ve registry portlari degistirilirse host tarayicisindaki adres ag icindekinden farkli olur.
HOST_HTTPS_PORT=443
HOST_REGISTRY_PORT=5050
HOST_GITLAB_SSH_PORT=2222
# test-vm 8081-8090 -> host 18081-18090 (prova ekibi 8099 -> 18099); workstation 8080 -> host 18080
HOST_TESTVM_PORTS=18081-18090
HOST_TESTVM_PROVA_PORT=18099
HOST_WORKSTATION_WEB_PORT=18080
HOST_WORKSTATION_VITE_PORT=5173

# Sirlar: bos birakin, `make env` uretir.
GITLAB_ROOT_PASSWORD=
GITLAB_ADMIN_TOKEN=
NEXUS_ADMIN_PASSWORD=
JENKINS_ADMIN_PASSWORD=
SONAR_ADMIN_PASSWORD=
SONAR_DB_PASSWORD=
# Ekip parolalari bu degerden turetilir (bootstrap/lib.sh: ekip_parola).
LAB_SECRET=

# Nexus Community Edition onaylari. Bunlar size aittir; bootstrap yalnizca burada
# `evet` yazarsaniz isaretler. Metin: https://links.sonatype.com/products/nxrm/ce-eula
NEXUS_CE_EULA_KABUL=
NEXUS_CE_TELEMETRI_ONAY=

# Prova ekibi gibi ek ekip numaralari (bosluklu liste, ornegin: 99)
EK_EKIPLER=
